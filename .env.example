# Copy to .env.local and fill in. Never commit real values.

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Resend — https://resend.com (free, no card required)
RESEND_API_KEY=re_YOUR_KEY
# Optional. Default: onboarding@resend.dev (Resend's shared sandbox sender).
# Keep the default unless you've verified a domain in Resend.
RESEND_FROM=onboarding@resend.dev
